<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Artiste Peintre Autodidacte</title>
    <link href="/dist/output.css" rel="stylesheet">
    <link href="/dist/hamburgers.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Montserrat&family=Noto+Serif&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="node_modules/owl.carousel/dist/assets/owl.carousel.min.css" />
    <link rel="stylesheet" href="node_modules/owl.carousel/dist/assets/owl.theme.default.min.css" />
    <meta name="title" content="Asmaart - Artiste Peintre Autodidacte">
    <meta name="description" content="Asmaart est le site d'une artiste peintre autodidacte passionnée, offrant une galerie complète de ses œuvres originales vibrantes et colorées.">
    <meta name="keywords" content="Artiste peintre autodidacte,Peintures vibrantes,Galerie d'art en ligne,Œuvres d'art originales,Techniques de peinture,Inspiration artistique,Couleurs vives,Aquarelles et huiles">
    <meta name="robots" content="index, follow">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="language" content="French">
    <meta name="author" content="Asmaart">
</head>
<body>

<%- include('navigation') %>

<main class="relative text-white">
    <div class="">
        <img src="/img/logo.png" class="mx-auto w-3/5 md:w-1/2 max-w-lg p-4">
        <div class="mx-auto w-3/5 md:w-1/2 max-w-lg border-b-2 border-b-black"></div>
        <h1 class="text-lg md:text-2xl lg:text-4xl font-bold text-center pt-4 pb-8 px-2 uppercase font-light">
             Artiste Peintre Autodidacte
        </h1>
    </div>


    <div class="flex flex-col lg:flex-row lg:flex-row-reverse">
        <div class="lg:w-1/2 animate__animated animate__zoomIn">
            <img id="main-img" src="/img/profile.jpeg" class="px-24 pb-4 mx-auto lg:py-10 max-w-[23rem] lg:max-w-xl" style="border-radius: 50%">
        </div>
        <div id="bio" class="lg:w-1/2 text-center text-lg lg:text-2xl m-auto px-8 lg:pl-32 lg:pr-0">
            <div>
                <span class="text-balance italic"><%= bio %></span>
                <br>
                <span><%= bionext %></span>
            </div>
        </div>
    </div>

    <div class="mt-12">
        <h2 class="text-lg md:text-2xl lg:text-4xl font-bold text-center pt-8 pb-4 px-2 uppercase font-light">
            DERNIÈRES NOUVEAUTÉS
        </h2>
        <div class="px-4">
            <div id="new-carousel" class="owl-carousel owl-theme lg:!hidden">
                <% paints.filter(p => p.available).slice(0, 4).forEach(function(paint) { %>
                    <a href="gallery.html#paint-<%= paint.name.toLowerCase().replace(/\s+/g, '-') %>" class="px-2 block">
                        <img class="rounded-lg shadow-sm" src="<%= paint.pictures[0] %>" alt="<%= paint.name %>">
                        <div class="text-center mt-2 text-black">
                            <p class="font-semibold text-sm uppercase"><%= paint.name %></p>
                            <p class="text-xs text-gray-500"><%= paint.price %>€</p>
                        </div>
                    </a>
                <% }) %>
            </div>

            <div class="hidden lg:flex justify-between gap-4">
                <% paints.filter(p => p.available).slice(0, 4).forEach(function(paint) { %>
                    <a href="gallery.html#paint-<%= paint.name.toLowerCase().replace(/\s+/g, '-') %>" class="flex-1 group block">
                        <div class="overflow-hidden rounded-lg shadow-md">
                            <img class="w-auto max-h-[75vh] object-cover transition-transform duration-500 group-hover:scale-110"
                                 src="<%= paint.pictures[0] %>"
                                 alt="<%= paint.name %>">
                        </div>
                        <div class="text-center mt-3 text-black">
                            <h3 class="font-bold text-lg uppercase tracking-wider"><%= paint.name %></h3>
                            <p class="text-gray-600"><%= paint.price %>€</p>
                        </div>
                    </a>
                <% }) %>
            </div>
        </div>
    </div>

    <div class="">
        <h2 class="text-lg md:text-2xl lg:text-4xl font-bold text-center pt-8 pb-4 px-2 uppercase font-light">
            Reproductions
        </h2>
        <div id="main-carousel-container" class="pt-4">
                <div id="main-carousel" class="owl-carousel owl-theme py-4">
                    <% reproductions.forEach(function(r) { %>
                        <div>
                            <img class=" object-cover !w-auto" src="<%= r.image %>">
                            <div class="text-center mt-2 text-black">
                                <p class="text-sm uppercase text-gray-500">REPRODUCTION</p>
                                <p class="font-semibold text-sm uppercase"><%= r.name %></p>
                                <p class="text-sm text-gray-500"><%= r.price %>€</p>
                            </div>
                        </div>
                    <% }) %>
                </div>
        </div>
    </div>


    <div id="review-container">
    <h2 class="text-lg md:text-2xl lg:text-4xl font-bold text-center pt-12 pb-8 px-2 uppercase font-light">
        AVIS CLIENTS
    </h2>
    <div class="animate__animated animate__delay-1s animate__fadeInLeft">
        <div id="review-carousel" class="owl-carousel owl-theme relative">

            <% reviews.forEach(function(review) { %>
                <div class="w-screen">
                    <div class="flex flex-col md:flex-row items-center mx-6 md:mx-10 lg:mx-52  px-2 md:px-10 py-4 feedback">
                        <div class="md:w-1/4">
                            <img src="<%= review.picture %>" alt="Customer Image" class="rounded-full h-full w-full max-w-[10rem] md:max-w-[16rem] object-cover p-4">
                        </div>
                        <div class="w-3/4 px-8 md:px-11">
                            <div class="mb-2">
                                <h3 class="text-3xl font-semibold"><%= review.name %></h3>
                                <p class="text-gray-600"><%= review.city %></p>
                            </div>
                            <div class="text-sm md:text-xl text-gray-800 relative">
                                <blockquote><span class="text-balance"><%= review.review %></span></blockquote>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
    </div>

    <div class="mt-10">
        <h2 class="text-lg md:text-2xl lg:text-4xl font-bold text-center pt-4 pb-8 px-2 uppercase font-light" id="contact">
            CONTACT
        </h2>
        <p class="p-4 lg:px-32 text-center font-bold contact text-md lg:text-xl">
            <%= contact %>
        </p>
    </div>


    <%- include('contact') %>

</main>

<script src="https://kit.fontawesome.com/e04d7c62a8.js" crossorigin="anonymous"></script>
<script src="/node_modules/jquery/dist/jquery.js"></script>
<script src="/node_modules/owl.carousel/dist/owl.carousel.min.js"></script>
<script src="../script.js"></script>
</body>
</html>